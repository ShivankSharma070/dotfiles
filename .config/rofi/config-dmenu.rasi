/* -----------------------------------------------
 * Rofi Configuration —  / directory picker
 * ----------------------------------------------- */
configuration {
    modi:                   "run";
    lines:                  15;
    font:                   "SF Pro Display 10";
    case-sensitive:         false;
    show-icons:             false;
    sidebar-mode:           false;
}

* {
    bg0:        #0e0e0e;
    bg1:        #1a1a1a;
    bg2:        #252525;
    bg-sel:     #2e2e2e;
    fg0:        #e0e0e0;
    fg1:        #a0a0a0;
    accent:     #6e6e6e;
    urgent:     #cc4444;
    border:     #333333;
    background-color:   transparent;
    text-color:         @fg0;
}

window {
    background-color:   @bg0;
    border:             1px solid;
    border-color:       @border;
    border-radius:      5px;
    width:              800px;
    padding:            0px;
    location:           center;
    anchor:             center;
}

mainbox {
    background-color:   transparent;
    children:           [ inputbar, listview ];
    spacing:            0px;
    padding:            9px;
}

inputbar {
    background-color:   @bg1;
    border-radius:      4px;
    padding:            8px 10px;
    margin:             0px 0px 10px 0px;
    children:           [ prompt, entry ];
    spacing:            8px;
}

prompt {
    background-color:   transparent;
    text-color:         @accent;
    font:               "JetBrains Mono Bold 10";
}

entry {
    background-color:   transparent;
    text-color:         @fg0;
    placeholder:        "search dirs…";
    placeholder-color:  @fg1;
    cursor:             text;
}

listview {
    background-color:   transparent;
    lines:              15;
    scrollbar:          false;
    fixed-height:       true;
    spacing:            4px;
}

element {
    background-color:   transparent;
    border-radius:      6px;
    padding:            8px 10px;
    margin:             4px 0px;
}

element normal.normal {
    background-color:   transparent;
    text-color:         @fg0;
}

element selected.normal {
    background-color:   @bg-sel;
    text-color:         @fg0;
}

element alternate.normal {
    background-color:   transparent;
    text-color:         @fg0;
}

element-text {
    background-color:   transparent;
    text-color:         inherit;
}

message {
    background-color:   @bg1;
    border-radius:      6px;
    padding:            8px 12px;
    margin:             8px 0px 0px 0px;
}

textbox {
    background-color:   transparent;
    text-color:         @fg1;
}
