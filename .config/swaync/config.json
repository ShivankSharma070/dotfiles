{
  "$schema": "/etc/xdg/swaync/configSchema.json",

  "positionX": "right",
  "positionY": "top",
  "layer": "overlay",
  "layer-shell": true,
  "layer-shell-cover-screen": true,
  "ignore-gtk-theme": true,

  "control-center-layer": "top",
  "cssPriority": "user",
  "control-center-width": 420,
  "control-center-margin-top": 8,
  "control-center-margin-bottom": 8,
  "control-center-margin-right": 8,
  "control-center-margin-left": 0,

  "notification-2fa-action": true,
  "notification-inline-replies": true,
  "notification-window-width": 400,
  "notification-body-image-height": 200,
  "notification-body-image-width": 200,
  "notification-grouping": true,
  "notification-window-height": -1,

  "timeout": 8,
  "timeout-low": 5,
  "timeout-critical": 0,
  "fit-to-screen": true,
  "keyboard-shortcuts": true,
  "image-visibility": "when-available",
  "transition-time": 200,
  "hide-on-clear": true,
  "hide-on-action": true,
  "relative-timestamps": true,

  "script-fail-notify": true,

  "widgets": [
    "buttons-grid",
    "volume",
    "backlight",
    "mpris",
    "title",
    "notifications"
  ],

  "widget-config": {
    "title": {
      "text": "Notifications",
      "clear-all-button": true,
      "button-text": "Clear All"
    },

    "notifications": {
      "vexpand": true
    },

    "mpris": {
      "autohide": true,
      "loop-carousel": true,
      "show-album-art": "when-available"
    },

    "volume": {
      "label": "󰕾",
      "show-per-app": true,
      "show-per-app-icon": true,
      "show-per-app-label": true,
      "empty-list-label": "No audio streams",
      "exec": "wpctl"
    },

    "backlight": {
      "label": "󰃟"
    },

    "buttons-grid": {
      "actions": [
        {
          "label": "󰂛",
          "command": "swaync-client -d",
          "type": "toggle",
          "tooltip": "Do Not Disturb",
          "update-command": "echo $(swaync-client --get-dnd)"
        },
        {
          "label": "󰖩",
          "command": "nmcli radio wifi toggle",
          "type": "toggle",
          "tooltip": "Wi-Fi",
          "update-command": "nmcli radio wifi | grep -q 'enabled' && echo true || echo false"
        },
        {
          "label": "󰂯",
          "command": "rfkill toggle bluetooth",
          "type": "toggle",
          "tooltip": "Bluetooth",
          "update-command": "rfkill list bluetooth | grep -q 'Soft blocked: no' && echo true || echo false"
        },
        {
          "label": "󰌾",
          "command": "hyprlock",
          "tooltip": "Lock Screen"
        },
        {
          "label": "󰐥",
          "command": "shutdown now",
          "tooltip": "Power Off"
        }
      ]
    }
  }
}
